<?xml version="1.0" encoding="UTF-8"?>
<!--
	===============================================
	ATELIER-KHEM.XML
	Fichier de données central du site Atelier KHEM.
	Toutes les sections, textes, images, sons et
	liens sont définis ici et chargés par app.js.
	STRUCTURE GÉNÉRALE :
	<atelier>
		<config>       : paramètres globaux (audio, animations, SEO)
		<accueil>      : contenu de la section héro
		<activites>    : liste de toutes les activités du site
			<activite>   : une activité (ex: remK, Guiah Songs...)
				<zone>     : une catégorie au sein de l'activité
					<item>   : un contenu (image + titre + texte)
		<footer>       : contenu du bas de page
	===============================================
-->
<atelier>
	<!-- ════════════════════════════════════
		CONFIGURATION GLOBALE
		════════════════════════════════════ -->
	<config>
		<!-- Audio ambiant : 1 = activé | 0 = désactivé -->
		<audio>1</audio>
		<!-- Animations de blobs : 1 = activé | 0 = désactivé -->
		<animation>1</animation>
		<!-- ── SEO ──
			Ces balises sont injectées dynamiquement dans le <head>
			par app.js pour le référencement et le partage social -->
		<seo>
			<!-- Titre de l'onglet du navigateur + balise og:title -->
			<title>Atelier KHEM - Atelier de création graphique et de transformation de matières premières</title>
			<!-- Description affichée dans Google et les aperçus de liens -->
			<description>
				Atelier KHEM réunit création graphique, branding, rhums arrangés artisanaux, huile de coco, huile de palmiste et autre huiles végétales, savons, briques de terre compressées stabilisés BTCS ainsi que des innovations locales au Cameroun.
			</description>
			<!-- Mots-clés (moins utilisés par Google, mais utiles pour d'autres moteurs) -->
			<keywords>
				rhum arrangé, branding, création graphique, vidéos publicitaires, Cameroun, artisanat, Kribi, Yaoundé
			</keywords>
			<!-- Auteur du site -->
			<author>Atelier KHEM</author>
			<!-- Image affichée lors du partage sur les réseaux sociaux -->
			<ogImage>https://atelier-khem.github.io/img/og-cover.jpg</ogImage>
		</seo>
		<theme>
			<background>#171C22</background>
			<primary>#C68346</primary>
			<secondary>#1FAF8C</secondary>
			<textSoft>#B7B0A7</textSoft>
		</theme>
	</config>
	<branding>
		<!-- Identité globale -->
		<siteName>Atelier KHEM</siteName>
		<siteUrl>https://atelier-khem.github.io/</siteUrl>
		<!-- Assets -->
		<logo>img/Logo.jpg</logo>
		<!-- Loader -->
		<loaderText>Initialisation des expériences</loaderText>
		<!-- Couleurs globales -->
		<colorPrimary>#C68346</colorPrimary>
		<colorSecondary>#1FAF8C</colorSecondary>
		<colorBackground>#171C22</colorBackground>
		<colorText>#B7B0A7</colorText>
	</branding>
	<!-- ════════════════════════════════════
		SECTION HÉRO (ACCUEIL)
		════════════════════════════════════ -->
	<accueil>
		<!-- Son ambiant de l'accueil (joué au chargement de la page) -->
		<sound>sounds/accueil.mp3</sound>
		<!-- Petit label au-dessus du titre (style pastille dorée) -->
		<badge>Atelier KHEM</badge>
		<!-- Titre principal. &lt;br&gt; = saut de ligne en HTML encodé pour le XML -->
		<titre><![CDATA[
<span style="color:#1FAF8C;">Créer</span><br>
<span style="color:#FF8A3D;">Transformer</span><br>
<span style="color:#2D6CDF;">Révéler</span>
]]></titre>
		<!-- Sous-titre / accroche -->
		<intro>Atelier de création graphique&lt;br&gt;et de transformation de matières premières</intro>
		<!-- Bouton CTA principal (Découvrir les activités) -->
		<ctaTexte>Découvre nos activités</ctaTexte>
		<!-- Lien vers la première activité (ancre HTML) -->
		<ctaLien>#rhumsarrangesremk</ctaLien>
		<!-- Bouton CTA secondaire (Contact WhatsApp) -->
		<ctaTexte2>Contacte-nous</ctaTexte2>
		<!-- Lien WhatsApp pré-rempli avec message d'introduction -->
		<ctaLien2>https://wa.me/237693474253?text=%5BEn%20provenance%20du%20site%20%2AAtelier%20KHEM%2A%20%28Accueil%29%5D%0A%0ABonjour%2C%0A%0AJ%27aimerai%20plus%20de%20renseignements%20sur%20...</ctaLien2>
	</accueil>
	<!-- Le reste du fichier continue avec exactement la même indentation :
		- 1 tabulation remplacée par 	
		- aucune ligne vide
		- structure XML conservée -->
</atelier>